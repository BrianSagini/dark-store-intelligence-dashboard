		annotation SummarizationSetBy = Automatic

	column description
		dataType: string
		lineageTag: c7230f28-03ed-4ab2-a992-3b321cc6dbe8
		summarizeBy: none
		sourceColumn: description

		annotation SummarizationSetBy = Automatic

	column avg_daily_demand
		dataType: double
		lineageTag: c5b7721f-96a3-4de8-9c0d-61e6c9939b5f
		summarizeBy: none
		formatString: 0.0
		sourceColumn: avg_daily_demand

		annotation SummarizationSetBy = Automatic

	column avg_stock_on_hand
		dataType: double
		lineageTag: 79316063-e59d-45e4-9daa-c94d1120d17f
		summarizeBy: none
		formatString: 0.0
		sourceColumn: avg_stock_on_hand

		annotation SummarizationSetBy = Automatic

	column days_of_supply
		dataType: double
		lineageTag: 44bab166-1a36-47b1-b86b-6ddf46ecde44
		summarizeBy: none
		formatString: 0.0
		sourceColumn: days_of_supply

		annotation SummarizationSetBy = Automatic

	column stockout_days
		dataType: int64
		lineageTag: 80fdbd05-6e4c-43e0-a21b-51835db4f8b6
		summarizeBy: none
		formatString: 0
		sourceColumn: stockout_days

		annotation SummarizationSetBy = Automatic

	column turnover_ratio
		dataType: double
		lineageTag: 13dd0895-85ef-41b3-a43a-b5a12bd8bfaa
		summarizeBy: none
		formatString: 0.00
		sourceColumn: turnover_ratio

		annotation SummarizationSetBy = Automatic

	measure 'Avg Turnover Ratio' = AVERAGE(InventorySummary[turnover_ratio])
		formatString: 0.00
		lineageTag: 6caa19e4-4df4-44a5-80fc-a7b8482ebf42

	measure 'Total Stockout Days' = SUM(InventorySummary[stockout_days])
		formatString: #,0
		lineageTag: 0e38356a-23a3-46b6-8f71-0b8c67030f34

	measure 'Avg Days of Supply' = AVERAGE(InventorySummary[days_of_supply])
		formatString: 0.0
		lineageTag: d0afb698-73d2-4671-9513-6f5ef7bc4fa5

	partition InventorySummary = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5433", "analytics"),
					dark_store_powerbi_inventory_summary = Source{[Schema="dark_store",Item="powerbi_inventory_summary"]}[Data]
				in
					dark_store_powerbi_inventory_summary

	annotation PBI_ResultType = Table
