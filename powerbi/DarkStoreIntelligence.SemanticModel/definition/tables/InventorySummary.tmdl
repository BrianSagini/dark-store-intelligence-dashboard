	column store_name
		dataType: string
		lineageTag: 49571307-fab2-4f8d-9418-3ef518da4008
		summarizeBy: none
		sourceColumn: store_name

		annotation SummarizationSetBy = Automatic

	column stock_code
		dataType: string
		lineageTag: 8b64ca3f-512d-44fc-9a47-fe4008872d58
		summarizeBy: none
