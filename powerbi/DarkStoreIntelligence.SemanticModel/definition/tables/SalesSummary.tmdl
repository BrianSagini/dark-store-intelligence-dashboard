	measure 'Total Revenue' = SUM(SalesSummary[revenue])
		formatString: "$"#,0
		lineageTag: 0a5084c3-6be4-4f0b-b69a-c737826d70f6

	measure 'Total Orders' = SUM(SalesSummary[orders_count])
		formatString: #,0
		lineageTag: f2c89dfb-b086-4e1f-8cd1-22082df34c19

	measure 'Avg Order Value' = DIVIDE([Total Revenue], [Total Orders])
		formatString: "$"#,0
		lineageTag: f21c1be6-8a3f-4b06-8486-7e06588b2431

	partition SalesSummary = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5435", "analytics"),
					dark_store_powerbi_sales_summary = Source{[Schema="dark_store",Item="powerbi_sales_summary"]}[Data]
				in
					dark_store_powerbi_sales_summary

	annotation PBI_ResultType = Table
