	measure 'Total Revenue' = SUM(SalesSummary[revenue])
		formatString: "\$"#,0
		lineageTag: fd77ef4a-171d-4fd1-973f-10cbfd06aa8d

	measure 'Total Orders' = SUM(SalesSummary[orders_count])
		formatString: #,0
		lineageTag: e839f112-6f0f-410c-bd41-d96df5c7229c

	measure 'Avg Order Value' = DIVIDE([Total Revenue], [Total Orders])
		formatString: "\$"#,0.00
		lineageTag: f9a4b056-14a9-4aff-9321-96d862822c18

	partition SalesSummary = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5433", "analytics"),
					dark_store_powerbi_sales_summary = Source{[Schema="dark_store",Item="powerbi_sales_summary"]}[Data]
				in
