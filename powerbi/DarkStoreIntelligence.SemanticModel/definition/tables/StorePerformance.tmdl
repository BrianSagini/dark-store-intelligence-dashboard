		annotation SummarizationSetBy = Automatic

	measure 'Total Profit (Est.)' = SUM(StorePerformance[profit_estimate])
		formatString: "$"#,0
		lineageTag: 2635df47-0d8d-49af-87db-fad9c0d27af4

	measure 'Avg ROI %' = AVERAGE(StorePerformance[roi_pct])
		formatString: 0.0"%"
		lineageTag: 6cc79438-4ff9-450f-9fff-52f70050c6f5

	partition StorePerformance = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5433", "analytics"),
					dark_store_powerbi_store_performance = Source{[Schema="dark_store",Item="powerbi_store_performance"]}[Data]
				in
					dark_store_powerbi_store_performance

	annotation PBI_ResultType = Table
