	measure 'Total Profit (Est.)' = SUM(StorePerformance[profit_estimate])
		formatString: "$"#,0
		lineageTag: 5a680390-5878-4a58-8ef6-3da18e89c509

	measure 'Avg ROI %' = AVERAGE(StorePerformance[roi_pct])
		formatString: 0.0"%"
		lineageTag: 47f478e2-cdf1-49bb-a770-123450ad936f

	partition StorePerformance = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5435", "analytics"),
