model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Stores", "SalesSummary", "InventorySummary", "StorePerformance"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Stores
ref table SalesSummary
ref table InventorySummary
ref table StorePerformance

ref cultureInfo en-US
